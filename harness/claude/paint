#!/usr/bin/env bash
# Run one painter in a studio with Claude Code, the way harness/painter runs one with pi:
# the painter's system prompt, the easel's tools (easel-mcp.ts) and nothing else.
#
#   harness/claude/paint <studio> [message]
#
# The studio is an exported one (engine/scripts/export_r16_studio) with a BRIEF.md. Claude Code
# runs headless (-p) from the studio with:
#   - the system prompt engine/harness/painter/system_prompt.md (claude-paint's), in place of
#     Claude Code's own;
#   - no built-in tools (--tools ""), only mcp__easel__{paint,look,note,status,log,read}
#     from easel-mcp.ts, which fences `read` to the studio as the pi harness does;
#   - no settings, hooks, CLAUDE.md, memory or other MCP servers (--setting-sources "",
#     --strict-mcp-config): nothing of the machine's own setup reaches the painter;
#   - compaction at 200k tokens (--autocompact), which bounds the images resent with
#     each request (see easel-mcp.ts).
#
# Writes <studio>/out/claude/session.jsonl (Claude Code's stream-json: every turn,
# tool call and result), stderr.log and reply.txt (the painter's last message), then
# closes the easel so its save file (out/easel/painting/live.ckpt) is there for
# scripts/finish_painting.
#
# Environment:
#   PAINTER_MODEL    default claude-opus-5-5
#   PAINTER_EFFORT   default high (the pi lanes ran --thinking high)
#   PAINTER_HOURS    wall-clock limit, default 4 (bash's own watchdog: no GNU timeout
#                    needed, so macOS runs it as it is); at the limit the session is stopped and
#                    the easel closed: the log is the painting so far
#   RAYON_NUM_THREADS  the easel's thread budget (default 4: several painters share the machine)
#   CLAUDE           the claude binary (default: claude on PATH)
set -euo pipefail

[ $# -ge 1 ] || { echo "usage: $0 <studio> [message]" >&2; exit 2; }
studio=$(cd "$1" && pwd)
here=$(cd "$(dirname "$0")" && pwd)
[ -x "$studio/bin/easel" ] || { echo "$studio has no bin/easel" >&2; exit 1; }
[ -f "$studio/BRIEF.md" ] || { echo "$studio has no BRIEF.md" >&2; exit 1; }

message=${2:-"Your brief is in BRIEF.md in this folder. Your last message is your reply: the painting's title if you give it one and, if you like, a few sentences about the picture."}
model=${PAINTER_MODEL:-claude-opus-5-5}
effort=${PAINTER_EFFORT:-high}
hours=${PAINTER_HOURS:-4}
threads=${RAYON_NUM_THREADS:-4}
claude=${CLAUDE:-claude}
node=${NODE:-$(command -v node || echo "$HOME/.nvm/versions/node/v24.15.0/bin/node")}

out="$studio/out/claude"
mkdir -p "$out"
config="$out/mcp.json"
"$node" -e '
const [node, server, studio, threads] = process.argv.slice(1);
process.stdout.write(JSON.stringify({ mcpServers: { easel: { type: "stdio", command: node, args: [server, studio],
  env: { RAYON_NUM_THREADS: threads } } } }) + "\n");
' "$node" "$here/easel-mcp.ts" "$studio" "$threads" > "$config"

tools=mcp__easel__paint,mcp__easel__look,mcp__easel__note,mcp__easel__status,mcp__easel__log,mcp__easel__read

# a fresh session or the next sitting of one that stopped: --resume keeps its context
resume=()
if [ -s "$out/session_id" ]; then resume=(--resume "$(cat "$out/session_id")"); fi

echo "$(date -u +%FT%TZ) start model=$model effort=$effort hours=$hours ${resume[*]}" >> "$out/runs.log"
cd "$studio"
secs=$(awk "BEGIN{print int($hours*3600)}")
set +e
# job control on: a non-interactive bash starts background jobs with SIGINT
# ignored, and SIGINT is how the time limit and Stop end a sitting
set -m
"$claude" -p "${resume[@]}" \
    --model "$model" --effort "$effort" \
    --system-prompt "$(cat "$here/../../engine/harness/painter/system_prompt.md")" \
    --setting-sources "" --strict-mcp-config --mcp-config "$config" \
    --tools "" --allowedTools "$tools" \
    --autocompact 200k \
    --output-format stream-json --verbose \
    "$message" < /dev/null >> "$out/session.jsonl" 2>> "$out/stderr.log" &
cpid=$!
# the daemon's Stop interrupts this pid (on macOS there is no /proc to find it by)
echo "$cpid" > "$out/claude.pid"
# the wall-clock limit, without GNU timeout (macOS has none): interrupt claude
# at the limit, kill it a minute later if it is still there
(
  waited=0
  while kill -0 "$cpid" 2>/dev/null; do
    if [ "$waited" -ge "$secs" ]; then
      kill -INT "$cpid" 2>/dev/null
      for _ in $(seq 60); do kill -0 "$cpid" 2>/dev/null || exit 0; sleep 1; done
      kill -KILL "$cpid" 2>/dev/null
      exit 0
    fi
    sleep 5
    waited=$((waited + 5))
  done
) &
wpid=$!
wait "$cpid"
status=$?
kill "$wpid" 2>/dev/null
wait "$wpid" 2>/dev/null
rm -f "$out/claude.pid"
set +m
set -e

# the session's id (for a later sitting) and the painter's last message
"$node" -e '
const fs = require("fs"), readline = require("readline");
const [path, out] = process.argv.slice(1);
let sid = null, reply = null;
// line by line: a long session is hundreds of MB of looks
const lines = readline.createInterface({ input: fs.createReadStream(path, "utf8"), crlfDelay: Infinity });
lines.on("line", line => {
  let m;
  try { m = JSON.parse(line); } catch { return; }
  if (m.session_id) sid = m.session_id;
  if (m.type === "result" && typeof m.result === "string") reply = m.result;
});
lines.on("close", () => {
  if (sid) fs.writeFileSync(out + "/session_id", sid + "\n");
  if (reply !== null) fs.writeFileSync(out + "/reply.txt", reply.trimEnd() + "\n");
});
' "$out/session.jsonl" "$out"

"$studio/bin/easel" close > /dev/null 2>&1 || true
echo "$(date -u +%FT%TZ) end status=$status" >> "$out/runs.log"
exit $status
