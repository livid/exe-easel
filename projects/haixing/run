#!/usr/bin/env bash
# Six painters, one a chapter of 《数海星的女孩》 (story.md), each in a studio of its own
# with every tube (export profile "every", from main), run by Claude Code
# (harness/claude/paint) at the same time, detached from the shell that started them.
#
#   projects/haixing/run setup        export studios/haixing-1..6 and write their briefs
#   projects/haixing/run start [N…]   start the painters (all six, or the ones named)
#   projects/haixing/run status       each studio's runs.log, chunks and reply
#   projects/haixing/run finish [N…]  dry, varnish and crack each painting
#                                     (scripts/finish_painting) into out/final.png
#
# Studios live in studios/ (ignored by Git). PAINTER_* and RAYON_NUM_THREADS pass through
# to harness/claude/paint; this script sets RAYON_NUM_THREADS=3 (six easels, 20 cores)
# and PAINTER_HOURS=5 unless they are set.
set -euo pipefail
repo=$(cd "$(dirname "$0")/../.." && pwd)
here="$repo/projects/haixing"
studios="$repo/studios"
export PATH="$HOME/.cargo/bin:$PATH"
export RAYON_NUM_THREADS=${RAYON_NUM_THREADS:-3}
export PAINTER_HOURS=${PAINTER_HOURS:-5}

which_ones() { if [ $# -gt 0 ]; then echo "$@"; else echo 1 2 3 4 5 6; fi; }

case "${1:-}" in
setup)
  mkdir -p "$studios"
  for n in 1 2 3 4 5 6; do
    s="$studios/haixing-$n"
    [ -e "$s" ] && { echo "$s is there already" >&2; continue; }
    R16_BRANCH=main TMPDIR="${TMPDIR:-/tmp}" "$repo/scripts/export_r16_studio" every "$s" | tail -1
    sed "s/{{N}}/$n/g" "$here/BRIEF.md.in" > "$s/BRIEF.md"
    cp "$here/story.md" "$s/notes/story.md"
    python3 -I - "$here/story.md" "$n" > "$s/notes/chapter.md" <<'EOF'
import sys
story, n = sys.argv[1], int(sys.argv[2])
body = open(story, encoding="utf-8").read().split("\n[^1]:", 1)[0]
print(f"# 第{'一二三四五六'[n - 1]}章\n")
print([p.strip() for p in body.split("\n---\n")][n - 1])
EOF
  done ;;
start)
  shift
  for n in $(which_ones "$@"); do
    s="$studios/haixing-$n"
    mkdir -p "$s/out/claude"
    setsid nohup "$repo/harness/claude/paint" "$s" > "$s/out/claude/launcher.log" 2>&1 < /dev/null &
    echo "started haixing-$n (pid $!)"
  done ;;
status)
  for n in 1 2 3 4 5 6; do
    s="$studios/haixing-$n"
    [ -d "$s" ] || continue
    chunks=$(grep -c '^--@ chunk' "$s/paintings/lua/painting.lua" 2>/dev/null || true)
    looks=$(grep -c '"name":"mcp__easel__look"' "$s/out/claude/session.jsonl" 2>/dev/null || true)
    echo "haixing-$n: ${chunks:-0} chunks, ${looks:-0} looks · $(tail -1 "$s/out/claude/runs.log" 2>/dev/null)"
    [ -s "$s/out/claude/reply.txt" ] && sed 's/^/    /' "$s/out/claude/reply.txt" | head -12
  done ;;
finish)
  shift
  for n in $(which_ones "$@"); do
    s="$studios/haixing-$n"
    "$repo/scripts/finish_painting" "$s/paintings/lua/painting.lua" "$s/out/final.png"
  done ;;
*) sed -n '2,13p' "$0" >&2; exit 2 ;;
esac
